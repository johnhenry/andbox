    "example:02": "node examples/02-capability-limits-cut-off-abuse.mjs",
    "example:03": "node examples/03-network-allowlist-blocks-unapproved-hosts.mjs",
    "example:04": "node examples/04-runaway-code-gets-timed-out.mjs",
    "examples": "npm run example:01 && npm run example:02 && npm run example:03 && npm run example:04"
  },
  "keywords": [
    "sandbox",
    "worker",
    "isolation",
    "rpc",
    "browser",
    "javascript"
  ],
